# Test Supabase project (isolated from production!)
# E2E cleanup is destructive and refuses non-local hosts. If you really must
# run against a disposable remote project, set ALLOW_REMOTE_TEST_DB=1.
TEST_SUPABASE_URL=https://test-project.supabase.co
TEST_SUPABASE_ANON_KEY=eyJ...test-anon
TEST_SUPABASE_SERVICE_ROLE_KEY=eyJ...test-service-role
TEST_APP_URL=http://localhost:3000
# Must include the full origin used by TEST_APP_URL (scheme + host + port).
CSRF_ALLOWED_ORIGINS=http://localhost:3000

# Must match the running Next.js instance's env
CODE_HASH_PEPPER=test-pepper-must-match-app
ENCRYPTION_KEY=base64_32bytes_same_as_app
DOWNLOAD_SERVICE_TOKEN=test-token-must-match-app
