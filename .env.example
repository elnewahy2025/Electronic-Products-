# ─── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...              # server only — never expose

# ─── Google OAuth ────────────────────────────────────────────
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx

# ─── Google Drive (seller linking & Google Picker) ───────────
GOOGLE_DRIVE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=GOCSPX-xxxx
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/api/seller/drive/callback
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive.file
GOOGLE_PICKER_API_KEY=AIzaSy...
GOOGLE_PICKER_APP_ID=123456789012

# ─── Encryption (server only — 32-byte base64) ───────────────
ENCRYPTION_KEY=base64_32bytes...
CODE_HASH_PEPPER=random_long_string

# ─── File Processing / Download service (external) ───────────
PROCESSING_SERVICE_URL=https://...
PROCESSING_SERVICE_TOKEN=...
# Origin of the download Worker only (no /stream suffix). Locally: http://localhost:8787
DOWNLOAD_SERVICE_URL=https://...
# Must match the Worker's DOWNLOAD_SERVICE_TOKEN secret byte-for-byte.
DOWNLOAD_SERVICE_TOKEN=...
# App origin used by the Worker for internal resolve/complete calls (no trailing path).
APP_INTERNAL_URL=http://localhost:3010

# ─── Worker (internal cron / service auth) ───────────────────
WORKER_SECRET=change_me_to_a_long_random_string
CRON_SECRET=change_me_to_a_long_random_string

# ─── Supabase Storage ────────────────────────────────────────
SUPABASE_PREVIEWS_BUCKET=previews

# ─── (Phase 2) Video processing service ──────────────────────
# VIDEO_PROCESSOR_URL=
# VIDEO_PROCESSOR_TOKEN=

# ─── Admin backup storage (independent) ──────────────────────
BACKUP_STORAGE_ENDPOINT=https://...
BACKUP_STORAGE_BUCKET=...
BACKUP_STORAGE_ACCESS_KEY=...
BACKUP_STORAGE_SECRET_KEY=...
# Optional: GitHub Actions dispatch from /api/internal/worker/backup-cron
# BACKUP_GITHUB_REPO=owner/repo
# BACKUP_GITHUB_TOKEN=github_pat_...

# ─── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=المنصة
# Comma-separated FULL origins (scheme://host[:port]) allowed for CSRF checks.
# NEXT_PUBLIC_APP_URL is always included. Add tunnel/custom domains explicitly;
# x-forwarded-host from inbound requests is never trusted.
# CSRF_ALLOWED_ORIGINS=https://shop.example.com,https://tunnel.example.com

# ─── Security headers ───────────────────────────────────────
# Optional: endpoint that receives CSP violation reports (legacy format)
# Leave empty to disable reporting.
CSP_REPORT_URI=/api/csp-report

# ─── Email Notifications (SMTP or Resend) ───────────────────
# Configure EITHER RESEND_API_KEY OR SMTP_HOST/PORT/USER/PASS
# RESEND_API_KEY=re_...
SMTP_HOST=127.0.0.1
SMTP_PORT=55325
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
SMTP_FROM=no-reply@electronic-products.local

# ─── AI Cover Generation (Gemini Image) ─────────────────────
# Get a free API key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=AIza...
# GOOGLE_AI_API_KEY=AIza...

# ─── Optional Proxy / Edge Controls ─────────────────────────
# Set to 1 ONLY when all traffic is guaranteed to pass through Cloudflare
# TRUST_CLOUDFLARE_IP=0
# Optional local/dev Supabase reverse proxy target
# SUPABASE_PROXY_TARGET=http://127.0.0.1:55321

# ─── Error Tracking (Sentry — optional) ─────────────────────
# SENTRY_DSN=https://...@o0.ingest.sentry.io/0
# NEXT_PUBLIC_SENTRY_DSN=https://...@o0.ingest.sentry.io/0
# SENTRY_AUTH_TOKEN=sntrys_...
# SENTRY_ORG=your-org
# SENTRY_PROJECT=electronic-products
